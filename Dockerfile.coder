FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates python3 make g++ ripgrep && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/agent
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY src/coder-worker.ts src/coder-verification.ts src/coder-policy.ts src/coder-progress.ts src/
COPY templates/CODER_CONTRACT.md templates/CODER_CONTRACT.md
USER node
ENV CLAUDE_CONFIG_DIR=/state/claude
CMD ["node", "--version"]
