# Copy to .env and set the Agent Plan key for cloud tasks.
ARK_AGENT_PLAN_API_KEY=
GAME_ASSET_PROVIDER=ark_plan_seedream
GAME_ASSET_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
GAME_ASSET_MODEL=doubao-seedream-5.0-pro
SEEDANCE_PROVIDER=ark_plan_seedance
SEEDANCE_URL=https://ark.cn-beijing.volces.com/api/plan/v3/contents/generations/tasks
SEEDANCE_MODEL_STANDARD=doubao-seedance-2.0-fast
SEEDANCE_MODEL_FAST=doubao-seedance-2.0-fast
DOUBAO_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/plan
DOUBAO_MODEL=doubao-seed-2.1-pro
VLM_ATTEMPTS_PER_MODEL=1
RMBG_BASE_URL=
